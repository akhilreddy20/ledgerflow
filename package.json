{
  "name": "ledgerflow",
  "version": "1.0.0",
  "private": true,
  "description": "Event-driven payments platform with a double-entry ledger (NestJS, PostgreSQL, Kafka, Redis, Kubernetes, OpenTelemetry)",
  "workspaces": [
    "libs/*",
    "services/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b services/ledger services/payments services/notifications services/psp-simulator",
    "build:watch": "tsc -b -w services/ledger services/payments services/notifications services/psp-simulator",
    "clean": "rm -rf libs/*/dist services/*/dist libs/*/tsconfig.tsbuildinfo services/*/tsconfig.tsbuildinfo",
    "start:ledger": "node --require ./libs/common/dist/otel.js services/ledger/dist/main.js",
    "start:payments": "node --require ./libs/common/dist/otel.js services/payments/dist/main.js",
    "start:notifications": "node --require ./libs/common/dist/otel.js services/notifications/dist/main.js",
    "start:psp": "node --require ./libs/common/dist/otel.js services/psp-simulator/dist/main.js",
    "test": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration --runInBand",
    "e2e": "node scripts/e2e.js",
    "dlq:replay": "node scripts/dlq-replay.js",
    "invariants": "node scripts/check-invariants.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.56.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.2",
    "@opentelemetry/sdk-node": "^0.57.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ioredis": "^5.4.2",
    "kafkajs": "^2.2.4",
    "pg": "^8.13.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "~5.7.2"
  }
}
