# Copy to .env and `set -a; source .env; set +a` when running services on your host.
KAFKA_BROKERS=localhost:29092
REDIS_URL=redis://localhost:6379
KAFKA_PARTITIONS=6
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# per service (override when starting each one)
# DATABASE_URL=postgres://ledgerflow:ledgerflow@localhost:5432/ledger
# PORT=3001

# payments saga tuning
PSP_URL=http://localhost:3004
PSP_TIMEOUT_MS=2000
SAGA_TIMEOUT_MS=300000
SAGA_STUCK_AFTER_MS=30000
SAGA_RECOVERY_INTERVAL_MS=10000
SAGA_MAX_PSP_ATTEMPTS=8

# psp-simulator chaos
PSP_FAILURE_RATE=0
PSP_DECLINE_RATE=0

# Set to false only for Kafka-compatible emulators without idempotent-producer support.
KAFKA_IDEMPOTENT_PRODUCER=true
